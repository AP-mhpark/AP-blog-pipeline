[Unit]
Description=Blog Pipeline Web (Vite dev server)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/maeng/blog-pipeline/apps/web
# `which npm` 결과로 아래 경로를 맞게 바꿔주세요 (nvm 등으로 설치했다면 /usr/bin/npm이 아닐 수 있습니다).
ExecStart=/usr/bin/npm run dev
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
